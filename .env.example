APP_ENV=development
APP_NAME="Inventory SaaS"
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://inventory:inventory@localhost:5432/inventory
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Security
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Cache / jobs
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Storage
# local = carpeta en disco; s3 aun no esta implementado
STORAGE_BACKEND=local
STORAGE_ROOT=uploads
MAX_UPLOAD_SIZE_MB=10

# S3 compatible (para cuando se migre)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=inventory
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Lectura de facturas (OCR)
# El escaneo está construido y probado, pero el modelo espera a que el servidor
# tenga GPU. Mientras siga en "disabled", POST /invoices/scans responde
# 503 INVOICE_SCANNING_DISABLED y GET /health lo dice en features.
#
# El día que haya GPU: INVOICE_EXTRACTOR=local y la URL del servidor. Nada más.
#
# disabled = apagado (valor por defecto hoy)
# local = nuestro propio modelo, en nuestro servidor
# claude = solo para comparar; necesita `uv sync --extra claude`
# text = lector determinista para desarrollo y pruebas: ni llave ni red
INVOICE_EXTRACTOR=disabled
INVOICE_LOCAL_URL=http://localhost:8080/v1
INVOICE_LOCAL_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# json_schema fuerza la salida al esquema: es lo que vuelve usable un 7B.
# Bajar a json_object solo si el servidor de inferencia no lo soporta.
INVOICE_LOCAL_JSON_MODE=json_schema
# Si pusiste el servidor detrás de una llave; en red privada no hace falta.
# INVOICE_LOCAL_API_KEY=
INVOICE_TIMEOUT_SECONDS=180
# El costo de un modelo de visión es por píxel.
INVOICE_MAX_IMAGE_SIDE=1600
INVOICE_MAX_PAGES=4

# Solo para comparar contra el modelo propio (make invoice-eval)
# ANTHROPIC_API_KEY=
# INVOICE_MODEL=claude-opus-5-5
